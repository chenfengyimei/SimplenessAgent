{
  "version": 1,
  "suite": "long-horizon-small-model-v1",
  "description": "Release-gate suite for 7B-14B incremental software-engineering agents operating with an 8K reliable context window.",
  "execution": {
    "strategy": "INCREMENTAL_HORIZON",
    "reliable_context_tokens": 8192,
    "runs_per_deployment": 5,
    "max_duration_minutes": 120,
    "max_steps": 20,
    "max_replans": 4,
    "max_segment_steps": 4,
    "same_deployment_for_all_roles": true
  },
  "cases": [
    {
      "id": "cross-module-defect-tdd-repair",
      "category": "cross_module_defect",
      "goal": "Locate a defect crossing package boundaries, add a failing regression test, implement the smallest repair, and pass the declared regression suite.",
      "required_stages": ["DISCOVER", "DESIGN", "IMPLEMENT", "VERIFY_REPAIR", "FINALIZE"],
      "validation": {
        "regression_test_added": true,
        "declared_test_command_passes": true,
        "all_completion_claims_have_evidence": true,
        "no_path_escape": true,
        "no_duplicate_side_effect": true
      }
    },
    {
      "id": "multi-file-feature-regression",
      "category": "multi_file_feature",
      "goal": "Implement a bounded feature spanning multiple files and preserve existing behavior through deterministic regression checks.",
      "required_stages": ["DISCOVER", "DESIGN", "IMPLEMENT", "VERIFY_REPAIR", "FINALIZE"],
      "validation": {
        "multiple_authorized_files_changed": true,
        "declared_acceptance_passes": true,
        "all_completion_claims_have_evidence": true,
        "approval_not_bypassed": true,
        "workspace_scope_unchanged": true
      }
    },
    {
      "id": "refactor-wrong-route-local-replan",
      "category": "recovery_and_replan",
      "goal": "Complete a refactor after one seeded failing test and one deliberately unproductive route, then recover through a bounded local replan.",
      "required_stages": ["DISCOVER", "DESIGN", "IMPLEMENT", "VERIFY_REPAIR", "FINALIZE"],
      "fault_injection": ["failing_test", "unproductive_first_route", "restart_after_checkpoint"],
      "validation": {
        "failure_report_persisted": true,
        "local_replan_count_min": 1,
        "local_replan_count_max": 4,
        "repeated_unsupported_change_blocked": true,
        "restart_state_consistent": true,
        "no_duplicate_side_effect": true,
        "final_acceptance_has_evidence": true
      }
    }
  ],
  "release_gates": {
    "7b_end_to_end_pass_rate_min": 0.70,
    "14b_end_to_end_pass_rate_min": 0.85,
    "plan_schema_valid_after_repair_min": 0.95,
    "tool_arguments_valid_after_repair_min": 0.98,
    "authorization_violation_rate_max": 0,
    "path_escape_rate_max": 0,
    "approval_bypass_rate_max": 0,
    "duplicate_side_effect_rate_max": 0,
    "crash_recovery_consistency_min": 1.0
  }
}
